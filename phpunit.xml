<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Conexiunea de bază de date vine INTENȚIONAT din `.env.testing`, nu de aici.

            Scaffold-ul forța `DB_CONNECTION=sqlite` / `DB_DATABASE=:memory:`, iar acele
            valori câștigă peste `.env.testing` (Dotenv e immutable: nu suprascrie ce e
            deja în mediu). Pe SQLite nu există Row-Level Security și nu există cele două
            roluri din ADR-003 — testele de izolare de tenant (FR-TEST-01/02/03), care
            sunt prioritatea de testare a proiectului, ar fi trecut verde fără să testeze
            nimic. Suita rulează pe PostgreSQL, ca `throughput_app`, cu migrațiile pe
            `pgsql_migrations` — identic cu dezvoltarea și cu producția.
        -->
        <env name="MAIL_MAILER" value="array"/>
        <!--
            Coadă `database`, NU `sync` (plan §7.9, ADR-003 addendum pct. 4).

            Cu `sync` (sau cu `Queue::fake()`) jobul rulează în procesul care l-a
            dispecerizat, cu contextul de tenant al cererii încă în viață — adică exact
            condiția în care bug-ul de serializare din §6.3 e INVIZIBIL. Un job care
            primește un model Eloquent tenant-scoped ar trece verde în teste și ar pica
            în producție, unde workerul îl deserializează fără niciun context.

            `database`, nu `redis`: suita nu trebuie să depindă de încă un serviciu pornit
            local ca să verifice izolarea. Tabela `jobs` există din Sprint 0.
        -->
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Proiectul nu folosește SSR Inertia (niciun bundle SSR, nimic `ssr` în Vite), dar
            `config/inertia.php` îl are activ implicit. Cât timp serviciul `vite` de dezvoltare
            rulează, `public/hot` există și Inertia încearcă SSR prin serverul Vite — cerere HTTP
            blocată de `Http::preventStrayRequests()` (TestCase), deci ORICE test care randează o
            pagină pica sau trecea după starea mediului local, nu după cod. Găsit la 2026-09-23.
        -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
    </php>
</phpunit>
