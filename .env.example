# Throughput — variabile de mediu (plan-implementare.md §2)
#
# Acest fișier e ȘABLON. `.env` cu valori reale există DOAR local, pentru dezvoltare.
# Pe Coolify toate valorile se setează din Coolify -> Environment Variables și se
# injectează la runtime: niciun .env cu date reale nu ajunge în imagine sau în Git.

# --- Aplicație și tenancy (§2.1) ---
APP_NAME=Throughput
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Interfața e în engleză (§0 din specs.md). Fus orar UTC — piață internațională.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Demo public cu scriere reală (§22 din specs.md, BR-PUB-01).
DEMO_MODE=true
DEMO_EMAIL_ALLOWLIST=
DEMO_RESET_CRON="0 3 * * *"

# Plafoane (§22.2, FR-IMP-02, FR-API-05).
BULK_MAX_ROWS_ABSOLUTE=60000
API_RATE_LIMIT_PER_MINUTE=300

# §22.5 — operații în masă concurente PER UTILIZATOR (nu per tenant, ca importul).
# Aceeași limită pentru toate rolurile, inclusiv exportul Viewer-ului (BR-BULK-03).
BULK_CONCURRENT_PER_USER=3

# Import CSV (§14.1, FR-IMP-02, §22.5). Cele două plafoane de fișier sunt independente:
# un fișier de 20 MB poate avea sub 50.000 de rânduri și invers.
IMPORT_MAX_ROWS=50000
IMPORT_MAX_FILE_MB=20
IMPORT_CHUNK_SIZE=500
IMPORT_CONCURRENT_PER_TENANT=1
IMPORT_STUCK_MINUTES=15
IMPORT_ABANDONED_HOURS=24
IMPORT_RETENTION_DAYS=7

# US-CRM-03, §13.2: sub prag, exportul CSV răspunde sincron; peste el, job pe coada `bulk`.
EXPORT_SYNC_MAX_ROWS=5000

# DOC-06 (audit infra 2026-09-23) — lipsea din acest fișier, deși config/throughput.php
# o citește. §13.5 (Orders), mereu pe coadă (ADR-013): DomPDF randează HTML în proces.
# 250, RECONFIRMAT pe container (Faza 4, nu pe Mac): peste 250 rânduri, marja sub
# plafonul de 256M al workerului `horizon` (docker/app/Dockerfile) scade sub 2×.
EXPORT_PDF_MAX_ROWS=250

# §16, rapoarte în xlsx: PhpSpreadsheet materializează rândurile în memorie ca DomPDF,
# deci are nevoie de propriul plafon (vezi și EXPORT_PDF_MAX_ROWS din config).
EXPORT_XLSX_MAX_ROWS=5000

# FR-GDPR-01, §20.5: linkul de descărcare al unui export expiră după atâtea zile —
# `PruneExpiredExportsJob` (plan §7.2) șterge fișierul, rândul rămâne.
EXPORT_RETENTION_DAYS=7

# §22.3: retenția jurnalului „Sent Emails" (conținut complet de email = date personale).
SENT_EMAIL_RETENTION_DAYS=7

# DOC-06 (audit infra 2026-09-23) — patru variabile lipsă din acest fișier, deși
# config/throughput.php le citește (§2.1 din plan-implementare.md).
#
# BR-BULK-02: plafonul DUR al Agentului pe o operație în masă de SCRIERE, per operație
# — regulă de business permanentă, distinctă de BULK_MAX_ROWS_ABSOLUTE (plafonul demo).
BULK_AGENT_ROW_CAP=500
# §13.2 pct. 2: mărimea unui chunk de operație în masă (job pe coada `bulk`).
BULK_CHUNK_SIZE=500
# BR-BILL-02: câte facturi încarcă odată `MarkOverdueInvoicesJob` la tranziția
# `sent -> overdue`. Coborâtă la 2 în teste, ca dovada iterării pe tranșe să nu ceară
# 501 comenzi reale per rulare.
OVERDUE_CHUNK_SIZE=500
# §13.2 (code review): o operație de SCRIERE rămasă pending/running FĂRĂ `batch_id` mai
# mult decât atât e considerată blocată (procesul a murit între dispatch și scrierea
# `batch_id`) — `FailStuckBulkOperationsJob` o închide ca `failed`.
BULK_STUCK_OPERATION_MINUTES=15

# DOC-06 — a cincea variabilă lipsă. FR-AUD-01, §17.2: rândurile din jurnalul de
# activitate mai vechi de atâtea luni, pentru entitățile cu date identificabile ale unei
# persoane (Contact, User), au `old_values`/`new_values` înlocuite cu `[anonymized]`.
# Rândul NU se șterge — structura rămâne pentru statistici agregate.
ACTIVITY_LOG_RETENTION_MONTHS=36

# OPS-05 (audit infra 2026-09-23): valorile de mai jos sunt pentru DEZVOLTARE locală —
# `stack`→`single` scrie pe disc (`storage/logs/laravel.log`), util cu `tail -f` local.
# În PRODUCȚIE (Coolify), ancora `x-app-env` din docker-compose.coolify.yml suprascrie
# cu `LOG_CHANNEL=stderr` / `LOG_LEVEL=warning`: `stderr` e captat de driverul Docker
# `json-file` și ajunge în log-urile Coolify, `single`/`stack` scriu pe volumul partajat
# `app_storage`, fără rotație, invizibil din Coolify. `warning` taie zgomotul de
# `debug`/`info` fără să piardă nimic ce ar declanșa o alertă Sentry.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Bază de date: DOUĂ conexiuni pe aceeași bază (ADR-003, §2.2) ---
# `pgsql` = rolul aplicației, FĂRĂ BYPASSRLS, non-proprietar de tabele.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=throughput
DB_USERNAME=throughput_app
DB_PASSWORD=secret

# `pgsql_migrations` = rolul de migrare, CU BYPASSRLS, proprietar de tabele.
# Folosit exclusiv de `php artisan migrate --database=pgsql_migrations`.
DB_MIGRATIONS_CONNECTION=pgsql_migrations
DB_MIGRATIONS_USERNAME=throughput_migrator
DB_MIGRATIONS_PASSWORD=secret

# Citite de docker/postgres/init/01-roles-and-extensions.sh la primul boot.
POSTGRES_BOOTSTRAP_PASSWORD=secret

# Migrațiile/seed-ul rulează doar unde e cerut explicit (containerul `app`, la deploy).
APP_RUN_MIGRATIONS=false
APP_RUN_SEEDERS=false

# --- Cache, cozi, sesiuni (§2.3) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cu două puncte la final: prefixul se concatenează direct la numele cheii, iar
# `throughput_horizon` fără ele produce chei de forma `throughput_horizonjobs:...`.
HORIZON_PREFIX=throughput_horizon:

# DOC-06 (audit infra 2026-09-23) — lipsea, deși config/horizon.php o citește
# (`'path' => env('HORIZON_PATH', 'horizon')`). Implicitul `horizon` e potrivit local.
# SEC-04: ÎN PRODUCȚIE trebuie o valoare NEGHICIBILĂ (nu `horizon`/`queue`/`admin`),
# ca strat suplimentar peste autentificarea de mai jos, nu în locul ei.
HORIZON_PATH=horizon

# OPS-03 — accesul la dashboard: HTTP Basic pe credențiale din env, nu pe un utilizator din
# baza de date (`demo:reset` o recreează în fiecare noapte, conturile demo au parole publice).
# Goale = nimeni nu intră (fail-closed), cu excepția mediului `local`. Parola în clar, lungă
# (`openssl rand -base64 32`): un hash bcrypt conține `$`, pe care interpolarea din compose
# și din Coolify îl mănâncă. Detalii: App\Http\Middleware\HorizonBasicAuth.
HORIZON_BASIC_AUTH_USER=
HORIZON_BASIC_AUTH_PASSWORD=

# --- Email: Resend prin SMTP (ADR-009, §2.4) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@throughput.dbg.ro"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe: EXCLUSIV test mode (BR-DEMO-03) ---
#
# `CASHIER_CURRENCY` e moneda ABONAMENTULUI pe care tenantul ni-l plătește NOUĂ, și e
# deliberat INDEPENDENTĂ de `tenants.currency` (moneda în care tenantul își facturează
# propriii clienți, implicit USD — specs.md §2.3). Cele două fluxuri de bani sunt separate
# prin ADR-005; faptul că pot diferi nu e o incoerență, e chiar separarea funcționând.
#
# `eur`, fiindcă produsele de test din Stripe („Throughput Starter"/„Throughput Pro") sunt
# în euro. Contează doar acolo unde Cashier formatează o sumă FĂRĂ monedă explicită:
# facturile de abonament își poartă moneda proprie (`Invoice::formatAmount()` primește
# `$this->invoice->currency`), deci istoricul de pe pagina de Billing e corect oricum.
CASHIER_CURRENCY=eur
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Curierat (ADR-010) ---
# Furnizorul activ și credențialele lui sunt PER TENANT, în `tenant_carrier_settings`,
# criptate la repaus. Cheile de mai jos există exclusiv ca seeder-ul să aibă ce scrie
# pentru tenanții 2 și 3 — la runtime nu le citește nimeni. O variabilă globală de tip
# SHIPPING_CARRIER ar contrazice direct ADR-010, de aceea nu există.
SHIPPO_SANDBOX_KEY=

# --- Monitorizare (§25.2) ---
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
