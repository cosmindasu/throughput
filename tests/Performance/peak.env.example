# tests/Performance/peak.env.example
#
# Șablon pentru `--env-file` al stack-ului OPS-07 (docker-compose.peak.yml). Copiază-l în
# afara controlului de versiune (ex. `tests/Performance/peak.env`, deja în .gitignore prin
# regula generică `*.env`/`.env*` — verifică înainte de commit) și completează parolele —
# orice valori, stack-ul e efemer și izolat, fără date reale. `APP_KEY` trebuie generat:
#
#   php artisan key:generate --show
#
# (sau, fără PHP la îndemână: `echo "base64:$(openssl rand -base64 32)"`.)

APP_KEY=
POSTGRES_BOOTSTRAP_PASSWORD=peak-postgres-bootstrap
DB_DATABASE=throughput
DB_USERNAME=throughput_app
DB_PASSWORD=peak-app-password
DB_MIGRATIONS_USERNAME=throughput_migrator
DB_MIGRATIONS_PASSWORD=peak-migrator-password
REDIS_PASSWORD=peak-redis-password

# Portul publicat de nginx pe host — implicit 8099 (vezi docker-compose.peak.yml).
PEAK_NGINX_PORT=8099
